# Copy to /opt/videoroll-rust/config/videoroll.env (0600, root-owned).
# Use the existing PostgreSQL/schema and media root only AFTER audited cutover.
# No credentials or production defaults are supplied.
DATABASE_URL=
VIDEOROLL_V2_STORAGE_ROOT=
VIDEOROLL_V2_INTERNAL_TOKEN=
INTERNAL_API_SECRET=
# Optional first-admin setup only; preserve existing admin settings.
# ADMIN_BOOTSTRAP_SECRET=
VIDEOROLL_V2_STANDALONE=true
VIDEOROLL_V2_NATIVE_OUTBOX_ONLY=true
VIDEOROLL_V2_ENABLE_LEGACY_PUBLISH=false
VIDEOROLL_V2_COMPAT_WRITE=false
VIDEOROLL_V2_SAU_ENABLE_BROWSER_OUTBOX=false
VIDEOROLL_V2_SECURE_COOKIES=true
VIDEOROLL_V2_WORKERS=2
VIDEOROLL_V2_FFMPEG=/usr/bin/ffmpeg
VIDEOROLL_V2_FFPROBE=/usr/bin/ffprobe
VIDEOROLL_V2_YT_DLP=/usr/bin/yt-dlp
VIDEOROLL_V2_SOURCE_SCANNER=false
VIDEOROLL_V2_REMOTE_RENDER=false
# Original browser RenderWorker administration targets the native registry.
VIDEOROLL_V2_RENDER_MANAGEMENT_NATIVE=true
VIDEOROLL_V2_ENABLE_NATIVE_BILIBILI=false
VIDEOROLL_V2_BILIBILI_SUBTITLES=true
VIDEOROLL_V2_ENABLE_SAU_PUBLISH=false
VIDEOROLL_V2_SOCIAL_PUBLISHER_URL=http://127.0.0.1:18087
VIDEOROLL_V2_SAU_ENABLE_NATIVE_CHECK=false
VIDEOROLL_V2_SAU_ENABLE_NATIVE_LOGIN=false
VIDEOROLL_V2_SAU_ENABLE_NATIVE_PUBLISH=false
# When enabling SAU, all roles must point to the SAME original storage root:
# VIDEOROLL_V2_SAU_STORAGE_ROOT=
# SAU_RUNTIME_DIR=/opt/social-auto-upload-rust
# SAU_EXECUTABLE=/opt/social-auto-upload-rust/.venv/bin/sau
# SOCIAL_LOGIN_DISPLAY=:99
# SAU_COOKIES_DIR=/opt/social-auto-upload-rust/cookies
# Enable only with separately configured X11/noVNC and account validation.
# VIDEOROLL_V2_YOUDUB_PYTHON=/opt/youdub/.venv/bin/python
# VIDEOROLL_V2_YOUDUB_BRIDGE=/opt/videoroll-rust/current/scripts/native/youdub_bridge.py
# VIDEOROLL_V2_YOUDUB_RUNTIME=/4t/videoroll-rust-youdub
# VIDEOROLL_V2_PLAYOUT_ROOT=
# Model endpoints, API keys and models are configured via original DB settings.
# Do not set legacy orchestrator/compat/worker gateway URLs.

# Local model inference (third-party Python libraries only, no Python task API):
# VIDEOROLL_V2_LOCAL_INFERENCE_PYTHON=/opt/videoroll/venvs/subtitle/bin/python
# VIDEOROLL_V2_LOCAL_INFERENCE_BRIDGE=/opt/videoroll-rust/current/scripts/native/local_inference.py
# SUBTITLE_WHISPER_MODEL_DIR=/DATA/videoroll/data/models/whisper
# SUBTITLE_RAG_EMBEDDING_MODEL_DIR=/DATA/videoroll/data/models/embeddings
# Resident model idle eviction (seconds, 1..600); one model per role process.
# VIDEOROLL_V2_LOCAL_INFERENCE_IDLE_SECONDS=30
# Optional shared absolute lock path (default: .local-inference-gpu.lock in storage root).
# All native roles must use the SAME path on a local filesystem; never unlink while running.
# VIDEOROLL_V2_LOCAL_INFERENCE_GPU_LOCK=/DATA/videoroll/data/.local-inference-gpu.lock
# Optional retained legacy Fernet key; same key path as original Python.
# File must be regular, owned by the service user, mode 0600, not a symlink.
# VIDEOROLL_FERNET_KEY_PATH=/DATA/videoroll/data/secrets/fernet.key
# VIDEOROLL_DATA_ROOT=/DATA/videoroll/data
