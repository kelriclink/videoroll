[Unit]
Description=VideoRoll Redis
After=network.target
Before=videoroll.target
PartOf=videoroll.target

[Service]
Type=simple
User=videoroll
Group=videoroll
Environment=LD_LIBRARY_PATH=/opt/videoroll/lib
ExecStart=/opt/videoroll/bin/redis-server /opt/videoroll/config/redis.conf
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
LimitNOFILE=65536

[Install]
WantedBy=videoroll.target
