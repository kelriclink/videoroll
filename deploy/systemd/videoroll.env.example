DATABASE_URL=postgresql+psycopg://videoroll:CHANGE_ME@127.0.0.1:5432/videoroll
REDIS_URL=redis://127.0.0.1:6379/0
INTERNAL_API_SECRET=CHANGE_ME
ADMIN_BOOTSTRAP_SECRET=CHANGE_ME
DEVELOPMENT_MODE=false
CORS_ALLOW_ORIGINS=http://127.0.0.1:3001

VIDEOROLL_DATA_ROOT=/opt/videoroll/data
STORAGE_ROOT=/opt/videoroll/data/storage/objects
TMPDIR=/opt/videoroll/data/storage/.partial
WORK_DIR=/opt/videoroll/data/work/videoroll
SOCIAL_PUBLISH_WORK_DIR=/opt/videoroll/data/work/social-publisher
SUBTITLE_DICTIONARY_DATA_DIR=/opt/videoroll/data/dictionaries
SUBTITLE_WHISPER_MODEL_DIR=/opt/videoroll/data/models/whisper
SUBTITLE_RAG_EMBEDDING_MODEL_DIR=/opt/videoroll/data/models/embeddings

EGRESS_GATEWAY_URL=http://127.0.0.1:8020
ORCHESTRATOR_URL=http://127.0.0.1:8000
SUBTITLE_SERVICE_URL=http://127.0.0.1:8001
YOUTUBE_INGEST_URL=http://127.0.0.1:8002
BILIBILI_PUBLISHER_URL=http://127.0.0.1:8003
WORKFLOW_SERVICE_URL=http://127.0.0.1:8030
SOCIAL_PUBLISHER_URL=http://127.0.0.1:8010
PLAYOUT_MEDIA_ROOT=/opt/videoroll/data/storage/playout-media
TRUSTED_PROXY_HOSTS=127.0.0.1,localhost
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

HATCHET_DATABASE_URL=postgresql://videoroll:CHANGE_ME@127.0.0.1:5432/videoroll_hatchet
HATCHET_ADMIN_PASSWORD=CHANGE_ME
# Browser-visible origin, not Hatchet's internal API. For public HTTPS replace
# all three URLs/domain settings with the actual hostname and set insecure=false.
HATCHET_SERVER_URL=http://127.0.0.1:3001
HATCHET_FRONTEND_URL=http://127.0.0.1:3001/workflow-ui/
HATCHET_COOKIE_DOMAIN=127.0.0.1
HATCHET_COOKIE_INSECURE=true
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_SERVER_URL=http://127.0.0.1:8888
HATCHET_CLIENT_HOST_PORT=127.0.0.1:7077
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_WORKER_NAME=videoroll-workflow-core-01
HATCHET_WORKER_SLOTS=4
HATCHET_SUBTITLE_WORKER_NAME=videoroll-subtitle-01
HATCHET_SUBTITLE_WORKER_SLOTS=6
# Chinese dubbing is opt-in; install a separate TTS venv before enabling its unit.
VIDEOROLL_DUBBING_VENV=/opt/videoroll/venvs/dubbing
HATCHET_DUBBING_WORKER_NAME=videoroll-dubbing-01
HATCHET_DUBBING_WORKER_SLOTS=1
DUBBING_TTS_DEVICE=cuda:0
# Weight downloads run in an independent small venv; never install HF SDK into ASR/TTS workers.
DUBBING_MODEL_ROOT=/opt/videoroll/data/models/tts
DUBBING_DOWNLOAD_PYTHON=/opt/videoroll/venvs/dubbing-download/bin/python
HATCHET_SUBTITLE_JOB_LEASE_TTL_SECONDS=300

SUBTITLE_ASR_ENGINE=faster-whisper
SUBTITLE_WHISPER_MODEL=large-v3
SUBTITLE_WHISPER_DEVICE=cpu
SUBTITLE_WHISPER_COMPUTE_TYPE=int8
SUBTITLE_WHISPER_CPU_THREADS=0
SUBTITLE_WHISPER_NUM_WORKERS=1
SUBTITLE_OPENVINO_MODEL=
SUBTITLE_OPENVINO_DEVICE=GPU
SUBTITLE_OPENVINO_NUM_BEAMS=1
SUBTITLE_OPENVINO_MAX_NEW_TOKENS=448

FFMPEG_PATH=/usr/bin/ffmpeg
INTEL_GPU_RENDER_DEVICE=/dev/dri/renderD128
CELERY_PUB_CONCURRENCY=1
CELERY_SUB_MAX_TASKS_PER_CHILD=20

RENDER_WORKER_SERVER_URL=http://127.0.0.1:8000
RENDER_WORKER_ENROLLMENT_TOKEN=
RENDER_WORKER_CREDENTIAL=
RENDER_WORKER_CREDENTIAL_FILE=/opt/videoroll/data/state/render-worker/credential
RENDER_WORKER_KEY=local-render
RENDER_WORKER_NAME=local-render-node
RENDER_WORKER_BACKEND=auto
RENDER_WORKER_GPU_DEVICE=
RENDER_WORKER_MAX_CONCURRENCY=1
RENDER_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
RENDER_WORKER_WORK_DIR=/opt/videoroll/data/work/render-worker

YOUTUBE_USER_AGENT=Mozilla/5.0
YOUTUBE_COOKIE_FILE=
YOUTUBE_PROXY=
YOUTUBE_EXTRACTOR_ARGS_JSON=
BILIBILI_PUBLISH_MODE=web
TASK_QUEUE_TICK_INTERVAL_SECONDS=10
STORAGE_CLEANUP_INTERVAL_SECONDS=3600

# One internal dubbing service for Qwen3 and CosyVoice3 (loopback only).
DUBBING_SERVICE_URL=http://127.0.0.1:8040
DUBBING_SERVICE_TOKEN_FILE=/opt/videoroll/config/dubbing-service.token
DUBBING_QWEN_PYTHON=/opt/videoroll/venvs/dubbing/bin/python
COSYVOICE3_PYTHON=/opt/videoroll/venvs/cosyvoice3/bin/python
COSYVOICE3_REPO=/opt/videoroll/external/CosyVoice
# V100 initially uses single inference slot; models swapped on demand.
DUBBING_MODEL_LOAD_TIMEOUT=300
# Only allow TTS to write WAV files under this working directory.
DUBBING_OUTPUT_ROOT=/DATA/videoroll/data/storage/work
