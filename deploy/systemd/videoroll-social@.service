[Unit]
Description=VideoRoll social publisher (%i)
After=network-online.target videoroll-redis.service videoroll-hatchet-token.service videoroll@orchestrator.service
Wants=network-online.target
Requires=videoroll-redis.service videoroll-hatchet-token.service
PartOf=videoroll.target
ConditionPathExists=/opt/videoroll/venvs/social/bin/python

[Service]
Type=simple
User=videoroll
Group=videoroll
EnvironmentFile=/opt/videoroll/config/videoroll.env
Environment=PYTHONPATH=/opt/videoroll/current/src:/opt/videoroll/current/social-auto-upload
Environment=SAU_RUNTIME_DIR=/opt/videoroll/current/social-auto-upload
Environment=SAU_EXECUTABLE=/opt/videoroll/venvs/social/bin/sau
RuntimeDirectory=videoroll-social-%i
RuntimeDirectoryMode=0700
ExecStart=/opt/videoroll/libexec/videoroll-run-social-role %i
Restart=on-failure
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=60
KillMode=control-group
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
LimitNOFILE=65536

[Install]
WantedBy=videoroll.target
