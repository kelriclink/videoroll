[Unit]
Description=VideoRoll Hatchet worker token initialization
After=videoroll-hatchet.service
Requires=videoroll-hatchet.service
PartOf=videoroll.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/videoroll/libexec/videoroll-init-hatchet-token
TimeoutStartSec=240
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=videoroll.target
