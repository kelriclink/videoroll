[Unit]
Description=VideoRoll ffplayout
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=videoroll
Group=videoroll
EnvironmentFile=/etc/videoroll/videoroll.env
WorkingDirectory=/opt/videoroll/current/data/ffplayout
ExecStart=/usr/local/bin/ffplayout --listen 127.0.0.1:8787 --db /opt/videoroll/current/data/ffplayout/db/ffplayout.db --log-to-console
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/videoroll/current/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
