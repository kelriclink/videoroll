[Unit]
Description=VideoRoll ffplayout
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=videoroll
Group=videoroll
EnvironmentFile=/opt/videoroll/config/videoroll.env
WorkingDirectory=/opt/videoroll
ExecStart=/opt/videoroll/libexec/videoroll-run-ffplayout
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
