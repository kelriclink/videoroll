[Unit]
Description=VideoRoll native Web gateway
After=network-online.target videoroll@orchestrator.service
Wants=network-online.target
PartOf=videoroll.target
ConditionPathExists=/opt/videoroll/current/web/index.html

[Service]
Type=simple
User=videoroll
Group=videoroll
ExecStartPre=/opt/videoroll/bin/nginx -t -c /opt/videoroll/config/nginx.conf
ExecStart=/opt/videoroll/bin/nginx -c /opt/videoroll/config/nginx.conf -g "daemon off;"
ExecReload=/opt/videoroll/bin/nginx -c /opt/videoroll/config/nginx.conf -s reload
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGQUIT
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
LimitNOFILE=65536

[Install]
WantedBy=videoroll.target
