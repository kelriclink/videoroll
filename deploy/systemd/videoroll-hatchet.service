[Unit]
Description=VideoRoll Hatchet Lite
After=network-online.target
Wants=network-online.target
Before=videoroll.target
PartOf=videoroll.target
ConditionPathExists=/opt/videoroll/bin/hatchet-lite
ConditionPathExists=/opt/videoroll/share/hatchet/static-assets/index.html

[Service]
Type=simple
User=videoroll
Group=videoroll
EnvironmentFile=/opt/videoroll/config/videoroll.env
ExecStart=/opt/videoroll/libexec/videoroll-run-hatchet
Restart=on-failure
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
LimitNOFILE=65536

[Install]
WantedBy=videoroll.target
