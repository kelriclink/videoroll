[Unit]
Description=VideoRoll Hatchet Lite
After=network-online.target
Wants=network-online.target
Before=videoroll.target
PartOf=videoroll.target
ConditionPathExists=/usr/local/bin/hatchet-lite
ConditionPathExists=/usr/share/videoroll/hatchet/static-assets/index.html

[Service]
Type=simple
User=videoroll
Group=videoroll
EnvironmentFile=/etc/videoroll/videoroll.env
ExecStart=/usr/local/libexec/videoroll-run-hatchet
Restart=on-failure
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/videoroll/current/data/hatchet
LimitNOFILE=65536

[Install]
WantedBy=videoroll.target
