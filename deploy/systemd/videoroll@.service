[Unit]
Description=VideoRoll service (%i)
After=network-online.target videoroll-redis.service videoroll-hatchet-token.service
Wants=network-online.target
Requires=videoroll-redis.service videoroll-hatchet-token.service
PartOf=videoroll.target

[Service]
Type=simple
User=videoroll
Group=videoroll
EnvironmentFile=/etc/videoroll/videoroll.env
Environment=PYTHONPATH=/opt/videoroll/current/src:/opt/videoroll/current/social-auto-upload
Environment=HOME=/opt/videoroll/current/data/home
ExecStart=/usr/local/libexec/videoroll-run-role %i
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/videoroll/current/data
LimitNOFILE=65536

[Install]
WantedBy=videoroll.target
